{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "commitMessagePrefix": "deps",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the UniFi image tag held in Chart.yaml appVersion (linuxserver <version>-ls<build> tags).",
      "fileMatch": ["^unifi/Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+-ls\\d+)\"?"
      ],
      "autoReplaceStringTemplate": "appVersion: {{newValue}}",
      "depNameTemplate": "linuxserver/unifi-network-application",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Bump the UniFi image reference in the Artifact Hub images annotation in lockstep with appVersion.",
      "fileMatch": ["^unifi/Chart\\.yaml$"],
      "matchStrings": [
        "image:\\s*linuxserver/unifi-network-application:(?<currentValue>\\d+\\.\\d+\\.\\d+-ls\\d+)"
      ],
      "autoReplaceStringTemplate": "image: linuxserver/unifi-network-application:{{newValue}}",
      "depNameTemplate": "linuxserver/unifi-network-application",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    }
  ]
}