{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "commitMessagePrefix": "deps",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the UniFi image tag held in unifi/Chart.yaml appVersion (linuxserver <version>-ls<build> tags).",
      "fileMatch": ["^unifi/Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+-ls\\d+)\"?"
      ],
      "autoReplaceStringTemplate": "appVersion: {{newValue}}",
      "depNameTemplate": "linuxserver/unifi-network-application",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Bump the UniFi image reference in the Artifact Hub images annotation in unifi/Chart.yaml in lockstep with appVersion.",
      "fileMatch": ["^unifi/Chart\\.yaml$"],
      "matchStrings": [
        "image:\\s*linuxserver/unifi-network-application:(?<currentValue>\\d+\\.\\d+\\.\\d+-ls\\d+)"
      ],
      "autoReplaceStringTemplate": "image: linuxserver/unifi-network-application:{{newValue}}",
      "depNameTemplate": "linuxserver/unifi-network-application",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Bump the Open Terminal slim image tag held in open-terminal/Chart.yaml appVersion (<version>-slim variant tags).",
      "fileMatch": ["^open-terminal/Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+-slim)\"?"
      ],
      "autoReplaceStringTemplate": "appVersion: {{newValue}}",
      "depNameTemplate": "ghcr.io/open-webui/open-terminal",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-slim$"
    },
    {
      "customType": "regex",
      "description": "Bump the wyoming-openwakeword image tag held in wyoming-openwakeword/Chart.yaml appVersion (upstream release tags).",
      "fileMatch": ["^wyoming-openwakeword/Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "autoReplaceStringTemplate": "appVersion: {{newValue}}",
      "depNameTemplate": "rhasspy/wyoming-openwakeword",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Bump the wyoming-openwakeword image reference in the Artifact Hub images annotation in wyoming-openwakeword/Chart.yaml in lockstep with appVersion.",
      "fileMatch": ["^wyoming-openwakeword/Chart\\.yaml$"],
      "matchStrings": [
        "image:\\s*rhasspy/wyoming-openwakeword:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "autoReplaceStringTemplate": "image: rhasspy/wyoming-openwakeword:{{newValue}}",
      "depNameTemplate": "rhasspy/wyoming-openwakeword",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Bump the model-fetch curl image tag in wyoming-openwakeword (values.yaml modelFetch.image.tag and the Artifact Hub images annotation in Chart.yaml).",
      "fileMatch": [
        "^wyoming-openwakeword/(values\\.yaml|Chart\\.yaml)$"
      ],
      "matchStrings": [
        "repository:\\s*curlimages/curl\\s*\\n\\s*tag:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "image:\\s*curlimages/curl:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "autoReplaceStringTemplate": "{{newValue}}",
      "depNameTemplate": "curlimages/curl",
      "datasourceTemplate": "docker"
    }
  ]
}